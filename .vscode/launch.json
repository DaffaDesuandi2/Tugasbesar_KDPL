{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Node.js: Run PosTera Backend",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend",
            "restart": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Node.js: Run Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/tests/auth.test.js",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal"
        }
    ]
}
