{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Run PosTera Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Run Tests (Pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "tests/test_auth_security.py"
            ],
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": true
        }
    ]
}
