{
  "name": "postera-backend",
  "version": "1.0.0",
  "description": "PosTera Backend API with Express and PostgreSQL",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:admin": "node --test tests/admin.test.js",
    "test:authorization": "node --test tests/authorization.test.js",
    "test:articles": "node --test tests/articles.test.js",
    "test:articles:unit": "node --test tests/articles.unit.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.3"
  }
}
